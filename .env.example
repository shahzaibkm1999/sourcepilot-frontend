# ===================================================
# AI Software Planning Assistant Frontend - Environment Variables
# ===================================================
# Copy to `.env.local` and adjust for your setup.

# When the Vite dev server can't proxy (e.g. production preview), point this
# at the backend. In dev, leave empty and use the /api proxy in vite.config.ts.
VITE_API_BASE_URL=

# Used by vite.config.ts to know where to proxy /api in dev.
VITE_API_PROXY_TARGET=http://localhost:5000
